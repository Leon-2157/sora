        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    USERS ||--o{ PURCHASES : \&quot;mencatat\&quot;\n    USERS ||--o{ SALES : \&quot;mencatat\&quot;\n    USERS ||--o{ PURCHASES : \&quot;membatalkan\&quot;\n    USERS ||--o{ SALES : \&quot;membatalkan\&quot;\n    CATEGORIES ||--o{ PRODUCTS : \&quot;mengelompokkan\&quot;\n    SUPPLIERS ||--o{ PURCHASES : \&quot;memasok\&quot;\n    PURCHASES ||--|{ PURCHASE_ITEMS : \&quot;memiliki\&quot;\n    SALES ||--|{ SALE_ITEMS : \&quot;memiliki\&quot;\n    PRODUCTS ||--o{ PURCHASE_ITEMS : \&quot;dibeli pada\&quot;\n    PRODUCTS ||--o{ SALE_ITEMS : \&quot;dijual pada\&quot;\n\n    USERS {\n        bigint id PK\n        string name\n        string email UK\n        string password\n        string role \&quot;admin | staff\&quot;\n        boolean is_active\n        timestamp created_at\n        timestamp updated_at\n    }\n    CATEGORIES {\n        bigint id PK\n        string name UK\n        string description\n        timestamp created_at\n        timestamp updated_at\n    }\n    SUPPLIERS {\n        bigint id PK\n        string name\n        string contact_person\n        string phone\n        string email\n        text address\n        timestamp created_at\n        timestamp updated_at\n    }\n    PRODUCTS {\n        bigint id PK\n        bigint category_id FK\n        string sku UK\n        string name\n        text description\n        string unit\n        decimal selling_price\n        int stock \&quot;unsigned, default 0\&quot;\n        int min_stock \&quot;unsigned, default 0\&quot;\n        timestamp deleted_at \&quot;soft delete\&quot;\n        timestamp created_at\n        timestamp updated_at\n    }\n    PURCHASES {\n        bigint id PK\n        string number UK\n        bigint supplier_id FK\n        bigint user_id FK\n        string status \&quot;completed | cancelled\&quot;\n        decimal total\n        string notes\n        datetime transacted_at\n        datetime cancelled_at\n        bigint cancelled_by FK\n        string cancel_reason\n        timestamp created_at\n        timestamp updated_at\n    }\n    PURCHASE_ITEMS {\n        bigint id PK\n        bigint purchase_id FK\n        bigint product_id FK\n        int quantity\n        decimal unit_cost\n        decimal subtotal\n    }\n    SALES {\n        bigint id PK\n        string number UK\n        bigint user_id FK\n        string status \&quot;completed | cancelled\&quot;\n        decimal total\n        string notes\n        datetime transacted_at\n        datetime cancelled_at\n        bigint cancelled_by FK\n        string cancel_reason\n        timestamp created_at\n        timestamp updated_at\n    }\n    SALE_ITEMS {\n        bigint id PK\n        bigint sale_id FK\n        bigint product_id FK\n        int quantity\n        decimal unit_price\n        decimal subtotal\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="X7AMzJcQgnO7rBMS8X7Q-1">
